{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradeengine",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STRATEGY_ENGINE_DO",
        "class_name": "StrategyEngineDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-strategy-engine-do",
      "new_sqlite_classes": [
        "StrategyEngineDurableObject"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "TRADINGBOT_DB",
      "database_name": "tradingbot",
      "database_id": "b93f4c50-a519-422c-9b31-15244ef3184f"
    }
  ]
}
