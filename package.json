{
  "name": "tradeengine-admin-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --config dist/tradeengine/wrangler.json",
    "clean": "rm -rf dist rust-backend/target",
    "lint": "tsc --noEmit",
    "check:webhook-ack": "npx --yes tsx scripts/check-webhook-ack.mts",
    "check:webhook-parser": "npx --yes tsx scripts/check-webhook-parser.mjs",
    "check:strategy-queue-recovery": "node scripts/check-strategy-queue-recovery.mjs",
    "check:strategy-do-lifecycle": "npm run build && node scripts/check-strategy-do-lifecycle.mjs",
    "check:strategy-do-completion-advance": "node scripts/check-strategy-do-completion-advance.mjs",
    "check:strategy-do-idempotency": "node scripts/check-strategy-do-idempotency.mjs",
    "check:strategy-task-retry": "npx --yes tsx scripts/check-strategy-task-retry.mts",
    "check:strategy-planner": "npx --yes tsx scripts/check-strategy-planner.mts",
    "check:auto-signing": "npx --yes tsx scripts/check-auto-signing.mts",
    "check:jupiter-gasless": "npx --yes tsx scripts/check-jupiter-gasless.mts",
    "check:trade-pnl": "npx --yes tsx scripts/check-trade-pnl.mts",
    "check:max-lines": "node scripts/check-max-lines.mjs",
    "db:migrate:local": "node scripts/prepare-d1-migrations.mjs --local && CI=1 wrangler d1 migrations apply tradingbot --local",
    "db:migrate:remote": "node scripts/prepare-d1-migrations.mjs --remote && CI=1 wrangler d1 migrations apply tradingbot --remote",
    "cleanup:token-account-holders": "node scripts/cleanup-token-account-holders.mjs",
    "check:base-token-backfill:local": "wrangler d1 execute tradingbot --local --file ./scripts/check-base-token-backfill.sql",
    "check:base-token-backfill:remote": "wrangler d1 execute tradingbot --remote --file ./scripts/check-base-token-backfill.sql",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy --config dist/tradeengine/wrangler.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.2.0",
    "@mui/x-date-pickers": "^9.10.0",
    "@noble/ciphers": "^2.3.0",
    "@scure/bip39": "^2.2.0",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "dayjs": "^1.11.21",
    "lucide-react": "^0.546.0",
    "micro-ed25519-hdkey": "^0.1.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.84.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "utf-8-validate": "5.0.10"
  }
}
