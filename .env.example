# Cloudflare Worker environment variables / secrets
# Set these with: wrangler secret put PRIVATE_KEY_ENCRYPTION_KEY
#
# PRIVATE_KEY_ENCRYPTION_KEY - required for private-key import
#   Must be a 32-byte value encoded as base64 (44 chars) or hex (64 chars).
#   Generate a random key: openssl rand -base64 32
PRIVATE_KEY_ENCRYPTION_KEY="replace-with-base64-or-hex-32-byte-secret"

# SOLANA_RPC_URL - required for token metadata, balances, transaction fetching
#   Use a private RPC endpoint. Do NOT use free public endpoints like api.mainnet-beta.solana.com
#   Example providers: Helius, Quicknode, Triton, Alchemy, or your own validator
SOLANA_RPC_URL="https://your-private-rpc-endpoint-here.com"

# ALCHEMY_WEBHOOK_SIGNING_KEY - required by /api/webhooks/alchemy/notify
#   Copy this from the Alchemy webhook detail page. The Worker verifies the
#   X-Alchemy-Signature HMAC-SHA256 header against the raw request body.
ALCHEMY_WEBHOOK_SIGNING_KEY="whsec_replace_with_alchemy_signing_key"

# ALCHEMY_WEBHOOK_SECRET - optional backward-compatible alias for the same value
# ALCHEMY_WEBHOOK_SECRET="whsec_replace_with_alchemy_signing_key"
