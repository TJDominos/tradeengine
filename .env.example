# =============================================================================
# Local Development Server (.env for server.ts)
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file with real secrets.

# GEMINI_API_KEY: Google Gemini AI API key (optional – used for AI features).
GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted (used for self-referential links).
APP_URL="http://localhost:3000"

# BOT_SECRET_KEY: Primary bot wallet private key (base58 or JSON byte-array).
# Example base58: "4wBqpZM52...yourkey..."
# Example JSON:   "[12,34,56,...]"
BOT_SECRET_KEY=""

# FRONTEND_TOKEN: ****** used to authenticate requests to the Cloudflare Worker.
# Must match the FRONTEND_TOKEN secret set in the Worker (wrangler secret put FRONTEND_TOKEN).
FRONTEND_TOKEN=""

# SOLANA_RPC_URL: Fallback public Solana RPC endpoint (used when provider-specific URLs are not set).
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Optional: provider-specific RPC endpoints for the local server RPC pool.
# These are preferred over SOLANA_RPC_URL when set.
CHAINSTACK_RPC_URL=""
HELIUS_RPC_URL=""
TATUM_RPC_URL=""
TATUM_API_KEY=""

# CONTRACT_ADDRESS: Default Solana token contract address to monitor.
CONTRACT_ADDRESS=""

# CF_ACCESS_CLIENT_ID / CF_ACCESS_CLIENT_SECRET: Cloudflare Access service token
# for the /api/relay proxy (optional – only needed if Worker is behind CF Access).
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""
