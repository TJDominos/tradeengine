# Cloudflare Worker environment variables / secrets
# Set these with: wrangler secret put PRIVATE_KEY_ENCRYPTION_KEY
#
# PRIVATE_KEY_ENCRYPTION_KEY - required for private-key import
#   Must be a 32-byte value encoded as base64 (44 chars) or hex (64 chars).
#   Generate a random key: openssl rand -base64 32
PRIVATE_KEY_ENCRYPTION_KEY="replace-with-base64-or-hex-32-byte-secret"

# SOLANA_RPC_URL - optional preferred Solana HTTP RPC endpoint
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# ALCHEMY_WEBHOOK_SECRET - required by /api/webhooks/alchemy/notify
#   Configure the same value in the webhook URL query string (?secret=...) or
#   pass it as a bearer token when testing manually.
ALCHEMY_WEBHOOK_SECRET="replace-with-long-random-string"
