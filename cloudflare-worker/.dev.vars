# .dev.vars
# This file provides LOCAL development secrets for Cloudflare Workers (wrangler dev).
# Variables listed here are injected into the Worker during local development only.
# Do NOT commit real secrets to this file.
#
# Production secrets are managed via the Cloudflare Dashboard or:
#   wrangler secret put FRONTEND_TOKEN
#   wrangler secret put BOT_SECRET_KEY

# ****** used to authenticate dashboard/frontend requests to the Worker.
# Must match the FRONTEND_TOKEN secret configured in production.
FRONTEND_TOKEN="your_frontend_jwt_token_here"

# Primary bot wallet private key (base58-encoded or JSON byte-array string).
# Example base58: "4wBqpZM52...yourkey..."
# Example JSON array: "[12,34,56,...]"
BOT_SECRET_KEY="your_private_key_here"
